                    <p class="text-sm text-white/80">Enterprise-grade security protects you from attacks and downtime.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Hosting Plans Section -->
    <section id="panel-compute" role="tabpanel" aria-labelledby="tab-compute" class="max-w-7xl mx-auto px-4 py-16">
        <h1 class="text-4xl md:text-6xl font-extrabold leading-tight">Simple, Transparent Pricing.</h1>
        <p class="text-gray-400 mt-4">Pay only for what you use. No hidden fees, no surprises.</p>

        <form class="group/tiers ">
            <div class="container mx-auto px-4 ">
