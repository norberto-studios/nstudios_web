---
import Layout from "../layouts/Layout.astro"
import Card from "../components/Card.astro";
import TabBtn from "../components/TabBtn.astro";

const tab_btn_titles = ["Compute", "Storage", "Networking"];
let activeTab = tab_btn_titles[0];

const isPanelActive = (title) => title === activeTab;
---

<Layout>

    <!-- Hero -->
    <section class="max-w-7xl mx-auto px-4 py-16">
        <h1 class="text-5xl md:text-6xl font-extrabold leading-tight">Simple, Transparent Pricing.</h1>
        <p class="text-gray-400 mt-4">Pay only for what you use. No hidden fees, no surprises.</p>

        <!-- Tabs -->
        <div class="flex gap-2 mt-6 bg-zinc-950/60 border border-zinc-800 rounded-full p-2.5 backdrop-blur-xs md:w-fit">
            {tab_btn_titles.map((title: string) => <TabBtn title={title} selected={isPanelActive(title)}/>)}
        </div>

        <section id="panel-compute" role="tabpanel" aria-labelledby="tab-compute">

            <div class="grid gap-6 mt-6 md:grid-cols-3">
                <Card title="Small VM"
                      price="15"
                      items={["2 vCPU", "4 GB RAM", "80 GB SSD"]}/>
                <Card title="Medium VM"
                      price="40"
                      items={["4 vCPU", "8 GB RAM", "160 GB SSD"]}/>
                <Card title="Large VM"
                      price="90"
                      items={["8 vCPU", "16 GB RAM", "320 GB SSD"]}/>
            </div>
        </section>

        <section id="panel-storage" role="tabpanel" aria-labelledby="tab-storage" class="hidden">
            <div class="grid gap-6 mt-6 md:grid-cols-3">
                <Card title="Object Storage"
                      price="5"
                      items={["First 250GB included", "0.015/GB-mo thereafter"]}/>
                <Card title="Cold Storage"
                      price="3"
                      items={["Low-cost, infrequent access"]}/>
                <Card title="CDN Add‑On"
                      price="9"
                      items={["Global edge delivery"]}/>
            </div>
        </section>

        <section id="panel-networking" role="tabpanel" aria-labelledby="tab-networking" class="hidden">
            <div class="grid gap-6 mt-6 md:grid-cols-3">
                <Card title="Small VM"
                      price="15"
                      items={["2 vCPU", "4 GB RAM", "80 GB SSD"]}/>
                <Card title="Medium VM"
                      price="40"
                      items={["4 vCPU", "8 GB RAM", "160 GB SSD"]}/>
                <Card title="Large VM"
                      price="90"
                      items={["8 vCPU", "16 GB RAM", "320 GB SSD"]}/>
            </div>
        </section>

        <!-- Features -->
        <ul class="flex flex-wrap gap-6 mt-8 text-gray-300">
            <li class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-nst-coral"></span> Uptime SLA</li>
            <li class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-nst-coral"></span> DDoS Protection
            </li>
            <li class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-nst-coral"></span> Managed Backups
            </li>
        </ul>

        <!-- CTA -->
        <button class="mt-8 px-6 py-3 bg-nst-gradient text-nst-black font-bold rounded-lg shadow-lg">Start Your Free
            Trial
        </button>
    </section>

</Layout>

<script src="../scripts/test-tab.js"></script>

