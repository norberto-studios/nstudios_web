---
interface Props {
    href?: string;                 // if present → renders <a>
    label?: string;                // visible text (or use <slot/>)
    describedby?: string;          // id for aria-describedby
    variant?: 'default' | 'featured';
    loading?: boolean;
    disabled?: boolean;
    ariaLabel?: string;            // override accessible name
    // Any other attributes (id, data-*, etc.)
    [key: string]: any;
}

const {
    href,
    label,
    describedby,
    variant = 'default',
    loading = false,
    disabled = false,
    ariaLabel,
    ...attrs
} = Astro.props as Props;

const isFeatured = variant === 'featured';

const base =
    'mt-6 inline-flex w-full items-center justify-center gap-2 ' +
    'rounded-lg px-4 py-2.5 text-sm font-semibold leading-6 ' +
    'transition-colors duration-150 motion-reduce:transition-none ' +
    'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-nst-coral/90 ' +
    'focus-visible:ring-offset-2 focus-visible:ring-offset-black ' +
    'shadow-sm hover:shadow active:translate-y-[1px] ' +
    'disabled:opacity-50 disabled:cursor-not-allowed';

const defaultStyles =
    'text-white bg-white/10 ring-1 ring-inset ring-white/10 ' +
    'hover:bg-white/15 hover:ring-white/20';

const featuredStyles =
    'text-white bg-nst-coral ring-0 hover:bg-nst-coral/90';

const groupFeatured =
    'group-data-[featured]/tier:bg-nst-coral ' +
    'group-data-[featured]/tier:text-white ' +
    'group-data-[featured]/tier:ring-0 ' +
    'group-data-[featured]/tier:hover:bg-nst-coral/90';

const classes = `${base} ${isFeatured ? featuredStyles : defaultStyles} ${groupFeatured}`;
const stateAttr = loading ? 'loading' : 'idle';

const hasSlot = Astro.slots.has('default');
const text = label ?? (hasSlot ? '' : 'Buy plan');
---

{href ? (
    // Navigation button (anchor)
  <a
        href={disabled ? undefined : href}
        aria-disabled={disabled ? 'true' : undefined}
        tabindex={disabled ? -1 : undefined}
        aria-describedby={describedby}
        aria-label={ariaLabel ?? (hasSlot ? undefined : text)}
        class={classes}
        data-state={stateAttr}
        {...attrs}
>
    {/* Spinner (shown only when loading) */}
    <svg class={`h-4 w-4 animate-spin ${loading ? '' : 'hidden'}`} viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" opacity=".25" />
        <path d="M22 12a10 10 0 0 1-10 10" fill="none" stroke="currentColor" />
    </svg>

    {hasSlot ? <slot /> : <span class={loading ? 'sr-only' : ''}>{text}</span>}
    {loading && <span>Processing…</span>}
</a>
    ) : (
    // Action button
  <button
        type="button"
        aria-describedby={describedby}
        aria-label={ariaLabel ?? (hasSlot ? undefined : text)}
        class={classes}
        data-state={stateAttr}
        disabled={disabled || loading}
        {...attrs}
>
    <svg class={`h-4 w-4 animate-spin ${loading ? '' : 'hidden'}`} viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" opacity=".25" />
        <path d="M22 12a10 10 0 0 1-10 10" fill="none" stroke="currentColor" />
    </svg>

    {hasSlot ? <slot /> : <span class={loading ? 'sr-only' : ''}>{text}</span>}
    {loading && <span>Processing…</span>}
</button>
    )}
