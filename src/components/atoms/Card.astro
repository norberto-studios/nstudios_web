---
const {
    title,
    titleNote,
    darkGradiant = false,
    description,
    items = [],
    price,
    canHover = false,
    Icon
} = Astro.props;
---
<!-- Look for composite components in Astro -->

<div class=`flex flex-col items-center group h-full
${darkGradiant ? "bg-linear-to-t from-nst-card to-nst-card2" : "bg-white/10"} 
p-5 rounded-xl
 border border-white/10 shadow-md backdrop-blur-sm 
    ${canHover && "hover:border-nst-coral hover:shadow-lg hover:scale-105 transition-transform duration-300 ease-in-out cursor-pointer"}
    `>
    {Icon && <Icon class="text-nst-coral w-10 h-10 mb-2"/>}
    <h3 class=`text-lg font-bold mb-2 text-white`>{title}
        {titleNote && <span class="text-xs italic text-gray-400">{titleNote}</span>}
    </h3>
    {description && <p class="text-sm mb-2 text-white/90">{description}</p>}
    {items &&
            <!--<div class="text-white/70 mt-2 leading-relaxed">-->
                <ul class="flex flex-col items-start text-xs text-white/70 mb-2 list-disc list-inside">
                    {items.map((item: string) => <li>{item}</li>)}
                </ul>

    }
    {price &&
        <div class="text-nst-coral text-3xl font-extrabold mt-3.5 ">
            ${price}<span class="text-base font-semibold text-gray-400">/mo</span>
        </div>
    }
</div>