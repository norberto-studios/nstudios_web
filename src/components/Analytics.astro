---
const isDev = import.meta.env.MODE === 'development';
const trackingId = import.meta.env.PUBLIC_GA_TRACKING_ID
---

<script is:inline define:vars={{ trackingId }} async src={`https://www.googletagmanager.com/gtag/js?id=${trackingId}`}></script>
<script is:inline define:vars={{ isDev, trackingId }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', trackingId, {debug_mode: isDev});
</script>
