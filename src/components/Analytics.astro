---
// Optional: import from an environment variable
const GA_ID = import.meta.env.PUBLIC_GA_TRACKING_ID || 'G-XXXXXXXXXX';
---

<script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
<script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '${GA_ID}');
</script>
