---
import CheckIcon from "../../assets/icons/check-icon.svg";
import Badge from "../atoms/Badge.astro";
import Button from "../atoms/Button.astro";

type Frequency = "monthly" | "annually";

const {
    name,
    subtitle,
    isFeatured = false,
    priceMonthly,
    priceAnnually,
    discountPercent,
    priceUnit,
    ctaLabel,
    badgeLabel,
    features
} = Astro.props;

const isDiscountedPrice = discountPercent > 0;
// const discountedPrice =  (price: number) => ( Math.floor(price * (1 - (discountPercent / 100))));
const discountedPrice = (price: number, rate = 0.20) =>
    (Math.round(price * (1 - rate) * 100) / 100).toFixed(2);
---


<div {...(isFeatured && { 'data-featured': 'true' })}
     class="group/tier rounded-3xl p-8 ring-1   xl:p-10 data-[featured]:ring-2
     border-white/10 bg-linear-to-t from-nst-card to-nst-card2 ring-white/15 data-[featured]:ring-nst-coral">
    <div class="flex items-center justify-between gap-x-4">
        <h3 id="tier-tier-freelancer"
            class="text-lg/8 font-semibold text-white
            group-data-[featured]/tier:text-nst-coral"
        >{name}</h3>
        <Badge label={badgeLabel}/>
    </div>
    <p class="mt-4 text-sm/6 text-gray-300"
    >{subtitle}</p>


    <div class="mt-6 space-y-1 group/tiers" data-frequency={'monthly' /* 'monthly'|'annually' */}>
        {/* Old price */}
        {isDiscountedPrice && (
                <p class="flex items-end gap-2">
                    <del class="text-2xl leading-none tabular-nums font-semibold text-gray-400 line-through decoration-2 decoration-nst-coral">
        <span class="price--monthly hidden group-[:has([name=frequency][value=monthly]:checked)]/tiers:inline">
          ${priceMonthly}
        </span>
                        <span class="price--annually hidden group-[:has([name=frequency][value=annually]:checked)]/tiers:inline">
          ${priceAnnually}
        </span>
                    </del>
                    <span class="text-sm/6 font-semibold text-gray-400 whitespace-nowrap">/{priceUnit}</span>
                    <span class="ml-2 shrink-0 rounded-full px-2 py-0.5 text-xs font-medium text-nst-coral bg-nst-coral/15">Save 20%</span>
                </p>
        )}

        {/* Current price */}
        <p class="flex items-end gap-2">
            <ins class="no-underline text-4xl leading-none tabular-nums font-semibold tracking-tight text-white whitespace-nowrap">
      <span class="price--monthly hidden group-[:has([name=frequency][value=monthly]:checked)]/tiers:inline">
        ${isDiscountedPrice ? discountedPrice(priceMonthly) : priceMonthly}
      </span>
                <span class="price--annually hidden group-[:has([name=frequency][value=annually]:checked)]/tiers:inline">
        ${isDiscountedPrice ? discountedPrice(priceAnnually) : priceAnnually}
      </span>
            </ins>
            <span class="text-sm/6 font-semibold text-gray-400 whitespace-nowrap">/{priceUnit}</span>
        </p>

        {/* Optional sublabel for billing */}
        <p class="text-xs text-gray-400">
    <span class="hidden group-[:has([name=frequency][value=annually]:checked)]/tiers:inline">
      Billed ${((isDiscountedPrice ? discountedPrice(priceAnnually) : priceAnnually) * 12).toLocaleString(undefined, {minimumFractionDigits: 2})}
        /year
    </span>
        </p>
    </div>

    <Button label={ctaLabel} />

    {features &&
            <ul role="list" class="mt-8 space-y-3 text-sm/6 text-gray-600 xl:mt-10 dark:text-gray-300">
                {features.map((feature: string) => (
                        <li class="flex gap-x-3">
                            <CheckIcon class="h-6 w-5 flex-none text-nst-coral"/>
                            {feature}
                        </li>
                ))}
            </ul>
    }
</div>