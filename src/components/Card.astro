---
const { title, items=[], price } = Astro.props;

---
<article class="p-6 shadow-lg rounded-xl border border-zinc-800 min-h-60
                bg-linear-to-t from-nst-card to-nst-card2">
    <h3 class="text-xl font-normal">{title}</h3>
    <div class="text-gray-400 mt-2 leading-relaxed">
        <ul>
            {items.map((data: string) => <li>{data}</li>)}
        </ul>
    </div>
    <div class="text-nst-coral text-3xl font-extrabold mt-3.5">
        ${price}<span class="text-base font-semibold text-gray-400">/mo</span>
    </div>
</article>