---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import NStudioLogo from "../components/NStudioLogo.astro";
---
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <meta name="viewport" content="width=device-width"/>
    <meta name="generator" content={Astro.generator}/>
    <title>NSTUDIOS</title>
</head>

<body class="bg-nst-bg text-white relative">

<div class="fixed inset-0 -z-10 bg-nst-glow"></div>

<!-- Header -->
<header class="max-w-7xl mx-auto flex items-center gap-6 py-4 px-4">
    <NStudioLogo/>
    <nav class="ml-auto flex gap-6 text-gray-400">
        <a href="#" class="hover:text-white">Pricing</a>
        <a href="#" class="hover:text-white">Docs</a>
        <a href="#" class="hover:text-white">Dashboard</a>
        <a href="#" class="hover:text-white">Contact</a>
    </nav>
</header>
<div class="min-h-screen flex flex-col justify-between">
    <slot/>
    <Footer/>
</div>

</body>
</html>