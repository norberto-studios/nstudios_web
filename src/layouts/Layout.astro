---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import NStudioLogo from "../components/NStudioLogo.astro";
import HeaderMenu from "../components/nav/menu.svelte"
import Analytics from "../components/Analytics.astro";
---
<html lang="en">
    <head>
        <meta charset="utf-8"/>
        <Analytics/>
        <link rel="icon" type="image/svg+xml" href="favicon.svg"/>
        <meta name="viewport" content="width=device-width"/>
        <meta name="generator" content={Astro.generator}/>
        <title>NSTUDIOS</title>
    </head>

    <body class="bg-nst-bg text-white relative">

        <div class="fixed inset-0 -z-10 bg-nst-glow hidden md:block"></div>

        <!-- Header -->
        <header class="max-w-7xl mx-auto flex justify-between items-center py-4 px-6 ">
            <a href="/"><NStudioLogo/></a>
            <!--<HeaderMenu client:load/>-->
        </header>
        <div class="min-h-screen flex flex-col justify-between">
            <slot/>
            <Footer showInfoLinks={false}/>
        </div>
    </body>
</html>
